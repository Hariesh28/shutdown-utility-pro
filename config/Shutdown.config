# Shutdown Utility Pro configuration seed.
# Runtime settings are stored under %LOCALAPPDATA%\ShutdownUtilityPro.

CountdownSeconds=3
SoundFile=Shutdown.wav
PlaySound=true
WaitForSound=true
ShowNotification=true
EnableDesktopOnlyHotkey=false
Hotkey=Ctrl+Alt+Shift+S
StartInTray=false
MinimizeToTray=true
CloseToTray=true
StartWithWindows=false
ConfirmScheduledActions=true
RememberWindowPosition=true
DarkTheme=true
TestMode=true
ScheduledDefaultMinutes=10
